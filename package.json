{
  "name": "undal-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "UNDAL — 100% Free-Tier Food Delivery & Pickup Platform for Bangladesh (EN + বাংলা)",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/customer_web",
    "apps/admin_web"
  ],
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspace=@undal/shared-ts",
    "check:gates": "node infra/scripts/verify-gates.mjs",
    "test:gates": "node --test infra/scripts/verify-gates.test.mjs",
    "test:tokens": "node --test packages/shared_ts/test/tokens.test.mjs",
    "test:bootstrap": "node --test infra/scripts/bootstrap-admin.test.mjs",
    "test": "node --test infra/scripts/verify-gates.test.mjs infra/scripts/bootstrap-admin.test.mjs packages/shared_ts/test/tokens.test.mjs",
    "ci:plan": "npm run typecheck && npm test && npm run check:gates && node infra/scripts/bootstrap-admin.mjs --dry-run"
  }
}
