{
  "name": "undal-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "UNDAL — 100% Free-Tier Food Delivery & Pickup Platform for Bangladesh (EN + বাংলা)",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/customer_web",
    "apps/admin_web"
  ],
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:gates": "node infra/scripts/verify-gates.mjs",
    "test:db": "node --test supabase/test/*.test.mjs",
    "test:root": "node --test infra/scripts/verify-gates.test.mjs infra/scripts/bootstrap-admin.test.mjs",
    "test": "npm run test:root && npm run test:db && npm test --workspaces --if-present",
    "ci:plan": "npm run ci:all",
    "ci:all": "npm run typecheck && npm run build && npm test && npm run check:gates && node infra/scripts/bootstrap-admin.mjs --dry-run"
  }
}
