# Undal — response headers for the admin console. Licensed under PASVL-1.0.
#
# Cloudflare Pages reads this file at deploy time. The policy is scoped to `/admin/*` so it cannot
# widen the storefront's own policy, and it names no host: the console talks to its API through the
# same origin (`/api`), so `'self'` is the whole connect-src. `script-src 'self'` with no
# `unsafe-inline` is only survivable because the bundle ships no inline script and no inline style
# attribute written by hand — `verify-csp.mjs` proves both before publish.
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cache-Control: no-store
