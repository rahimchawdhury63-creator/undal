{
  "name": "@undal/storefront",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Undal web storefront: SEO-first ordering for browsers, with the partner and rider consoles.",
  "license": "LicenseRef-PASVL-1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && rm -rf dist/server",
    "build:client": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "5.1.0",
    "@fontsource/poppins": "5.1.0",
    "@undal/contracts": "workspace:*",
    "@undal/i18n": "workspace:*",
    "@undal/money": "workspace:*",
    "@undal/tokens": "workspace:*",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.1.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.7.4",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
