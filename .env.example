# ─────────────────────────────────────────────────────────────────────────────
#  Undal — Food and Groceries
#  Complete environment and configuration reference
#
#  Licensed under PASVL-1.0. Source is public. Deployment requires a LOSDA.
#  SPDX-License-Identifier: LicenseRef-PASVL-1.0
# ─────────────────────────────────────────────────────────────────────────────
#
#  THIS FILE CONTAINS NO REAL VALUES. Every entry below is a shape, a range or
#  an obviously fake example. `secret-scan` runs over this file like any other.
#
#  There are three layers of configuration in Undal. Know which one you are in:
#
#    1. GITHUB ACTIONS SECRETS  — credentials and deployment identity.
#                                 Settings → Secrets and variables → Actions.
#                                 44 register entries, 48 variable lines.
#                                 Documented in docs/29 §2.
#
#    2. platform_config         — business rules, in the database, temporal and
#                                 zone-scoped, changeable from the admin panel
#                                 without a deploy. 147 keys. docs/29 §4.
#
#    3. CODE CONSTANTS          — the order state machine, the paisa base, the
#                                 ledger posting rules. NOT configurable. If one
#                                 of these needs to change, it is a code change
#                                 with a test, not a setting.
#
#  Section A below is layer 1. Section B is layer 2. Layer 3 is not here
#  by design.
#
#  THERE IS NO LOCAL DEVELOPMENT. This file is not loaded by anything at
#  runtime. It exists so that a human reading the repository can see exactly
#  what the platform needs, and so that `env-example-complete` can fail the
#  build when something referenced in code is missing from it.
#
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
#  SECTION A — GITHUB ACTIONS SECRETS
# ═════════════════════════════════════════════════════════════════════════════
#
#  Legend
#    [M]  Mandatory — the platform will not run without it. There are 12.
#    [O]  Optional — the capability degrades gracefully and `health.yml`
#         reports it as unavailable with the reason.
#    [R]  Rotation-overlap only — set during a key rotation, removed after.
#
#  Blast radius notes are abbreviated here; docs/29 §2 has the full table and
#  docs/29 §5 has the rotation procedure for every one of them.


# ─── A1. Database ────────────────────────────────────────────── 3 entries ───
#
#  The application role and the migration role are DIFFERENT DATABASE USERS.
#  The application role has SELECT/INSERT/UPDATE/DELETE on business tables,
#  INSERT and SELECT ONLY on audit_log, and no DDL whatsoever. That grant is
#  what makes the WORM guarantee in docs/27 §4.2 real rather than aspirational.
#  Do not use one URL for both.

# [M] Blast radius: TOTAL. Full read/write on every table.
COCKROACH_DATABASE_URL=postgresql://undal_app:REPLACE_ME@your-cluster-0000.gcp-asia-south1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# [M] The CockroachDB Cloud CA certificate, PEM, newlines preserved.
#     Low blast radius alone; it is what makes verify-full meaningful.
COCKROACH_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIB…REPLACE_ME…\n-----END CERTIFICATE-----"

# [O] Used by migrate.yml ONLY. Higher privilege: DDL plus everything above.
#     Never given to a Worker.
COCKROACH_MIGRATION_URL=postgresql://undal_migrator:REPLACE_ME@your-cluster-0000.gcp-asia-south1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full


# ─── A2. Cloudflare ──────────────────────────────────────────── 4 entries ───

# [M] Scope it to EXACTLY: Workers Scripts Edit, Pages Edit, D1 Edit,
#     Workers KV Storage Edit. Never an account-wide token.
CLOUDFLARE_API_TOKEN=0000000000000000000000000000000000000000

# [M]
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000

# [M] The D1 database holding rider positions and nothing else (docs/07).
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# [M] KV namespace for the FCM token cache, platform_config cache and the
#     registration draft store.
KV_NAMESPACE_ID=00000000000000000000000000000000


# ─── A3. Media ───────────────────────────────────────────────── 4 entries ───
#
#  Destination is chosen by the MediaKind enum (docs/26 §1), never by a call
#  site. imgbb has NO access control — anything sensitive goes to Cloudinary.

# [M] Never shipped to a client. All uploads are proxied through undal-core.
IMGBB_API_KEY=00000000000000000000000000000000

# [O] Public by design; it appears in delivery URLs.
CLOUDINARY_CLOUD_NAME=your-cloud-name

# [O] Unsigned preset, restricted to the undal/sensitive/ folder,
#     authenticated access mode, no transformations allowed.
CLOUDINARY_UPLOAD_PRESET=undal_sensitive_unsigned

# [O] Blast radius: HIGH. Together these sign delivery URLs for every stored
#     identity document. One register entry, two variables.
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=REPLACE_ME


# ─── A4. Notifications ───────────────────────────────────────── 3 entries ───
#
#  FCM v1 with service-account auth. There is no legacy server key anywhere in
#  this platform and `fcm-payload-purity` fails the build if one appears.

# [M] Blast radius: HIGH — can push to every device. Scope the service account
#     to the firebase.messaging role only. Used by undal-realtime and by
#     NOTHING else; undal-core cannot send a push.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"0000","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n","client_email":"undal-fcm@your-project.iam.gserviceaccount.com","client_id":"000000000000000000000","token_uri":"https://oauth2.googleapis.com/token"}

# [O] Public. Injected into the Android builds to generate google-services.json.
FCM_SENDER_ID=000000000000

# [O] HMAC key for the `sig` field on every data payload, so a client can
#     reject a forged message before it raises an alarm.
FCM_SIG_KEY=REPLACE_ME_32_BYTES_BASE64


# ─── A5. External services ───────────────────────────────────── 4 entries ───
#
#  Every one of these has a tested fallback. See docs/39 §3.2 for the honest
#  assessment of the public OSRM demo server.

# [O] Falls back to haversine × the learned per-zone detour factor,
#     which lands within about 8% of a routed distance.
OSRM_BASE_URL=https://router.project-osrm.org

# [O] Falls back to rider-speed inference. Weather premium is gated off below
#     a confidence of 0.5, so no premium is paid on a guess.
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# [O] Falls back to the public OSM tile server, whose usage policy the
#     platform respects (attribution, no bulk download, a real User-Agent).
TILE_BASE_URL=https://tile.openstreetmap.org

# [O] Falls back to manual address entry with a map pin, which is the
#     authoritative coordinate anyway.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org


# ─── A6. Auth ────────────────────────────────────────────────── 8 entries ───

# [M] Ed25519 private key, PKCS#8, base64. Blast radius: CRITICAL — forges any
#     session for any role. Rotate with the dual-key procedure in docs/29 §5;
#     it is zero-downtime.
JWT_SIGNING_KEY=REPLACE_ME_BASE64_ED25519_PKCS8

# [R] Set to the OLD value during a rotation. Accepted for VERIFICATION only,
#     never for signing. Remove 24 hours after the rotation.
JWT_PREVIOUS_KEY=

# [M] HMAC key for the pickup QR code. Blast radius: HIGH — forges a pickup.
#     Mitigated by the 150 m geofence and the 4-hour expiry, so a forged code
#     is only usable by someone standing at the restaurant.
ORDER_QR_SECRET=REPLACE_ME_32_BYTES_BASE64

# [R] Rotation overlap, same pattern as JWT_PREVIOUS_KEY.
ORDER_QR_PREVIOUS_SECRET=

# [O] AES-256 key wrapping every admin TOTP seed at rest. Blast radius:
#     CRITICAL. Rotating it re-encrypts every seed in a migration; admins are
#     not affected and do not re-enrol.
TOTP_ENCRYPTION_KEY=REPLACE_ME_32_BYTES_BASE64

# [O] Google sign-in. BOTH must be present or the button does not render —
#     there is no half-configured state and no broken button. docs/17 §3.
GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# [O] Admin SSO. One register entry, three variables. All three or none.
#     Claims are mapped to roles in the admin panel, not here.
ADMIN_OIDC_ISSUER=https://your-idp.example/
ADMIN_OIDC_CLIENT_ID=REPLACE_ME
ADMIN_OIDC_CLIENT_SECRET=REPLACE_ME


# ─── A7. Finance ─────────────────────────────────────────────── 1 entry ────
#
#  The brief asks for this to be an Actions secret, and it should be.

# [O] The number every rider sends their cash settlement to.
#
#     THIS IS THE HIGHEST FRAUD-RISK SECRET IN THE PLATFORM. A substituted
#     number diverts every rider's end-of-shift cash. Changing it requires two
#     approvals, sends an in-app notice to every rider showing the old and new
#     numbers, and the old number is honoured for 48 hours. docs/29 §2.7.
UNDAL_BKASH_PAYOUT_NUMBER=01XXXXXXXXX


# ─── A8. Public configuration ────────────────────────────────── 9 entries ───
#
#  > "the domain should not be fixed, it should be an Actions secret."
#
#  These are not secret in the cryptographic sense. They live here because the
#  secret store is the only configuration channel the brief permits, and
#  because it means anyone can deploy this repository to their own domain
#  without editing a single line of code. They are injected at compile time for
#  the clients and at deploy time for the Workers.

# [M] The storefront domain. Drives canonical URLs, sitemaps, hreflang,
#     Open Graph tags and App Link path claims.
PUBLIC_WEB_HOST=undal.example

# [M] The API origin the clients call.
PUBLIC_API_BASE=https://api.undal.example

# [O] Defaults to admin.${PUBLIC_WEB_HOST}.
PUBLIC_ADMIN_HOST=admin.undal.example

# [O] Used in page titles, transactional emails and invoice PDFs.
PUBLIC_BRAND_NAME=Undal

# [O] Shown on the SOS screen, in the help centre and on every invoice.
PUBLIC_SUPPORT_PHONE=+8801XXXXXXXXX

# [O]
PUBLIC_SUPPORT_EMAIL=support@undal.example

# [O] The city name shown before a user has set a location.
PUBLIC_DEFAULT_CITY=Sylhet

# [O] The initial map centre. One register entry, two variables.
PUBLIC_DEFAULT_LAT=24.8949
PUBLIC_DEFAULT_LON=91.8687

# [O] Initial map zoom level, 1–20.
PUBLIC_DEFAULT_ZOOM=13


# ─── A9. Android signing ─────────────────────────────────────── 6 entries ───
#
#  GENERATED BY .github/workflows/generate-keystore.yml, NOT by you, and not on
#  a machine. That workflow refuses to run if a keystore already exists, never
#  uploads the .jks as an artifact, shreds it, and prints these values to the
#  job summary. Copy them into secrets and then DELETE THE WORKFLOW RUN.

# [O] Base64 of the release keystore.
#
#     IRREPLACEABLE. If you lose this, no app you have published to Google Play
#     can ever be updated again. It cannot be rotated. Back it up somewhere
#     that is not this repository and not a chat window.
ANDROID_KEYSTORE_BASE64=REPLACE_ME_BASE64_JKS

# [O]
ANDROID_KEYSTORE_PASSWORD=REPLACE_ME

# [O]
ANDROID_KEY_ALIAS=undal-release

# [O]
ANDROID_KEY_PASSWORD=REPLACE_ME

# [O] The release certificate's SHA-256 fingerprint, colon-separated.
#     The web build writes this into /.well-known/assetlinks.json. A mismatch
#     silently breaks every App Link, which is why a post-deploy CI job fetches
#     the live file and compares it to this value. docs/31 §9.1.
ANDROID_SHA256_FINGERPRINT=AB:CD:EF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC

# [O] Enables automatic upload to a Play track. Without it the signed APK and
#     AAB are still produced and attached to a GitHub Release with checksums.
PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-play-project","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n","client_email":"play-publisher@your-play-project.iam.gserviceaccount.com"}


# ─── A10. Bootstrap admin ────────────────────────────────────── 2 entries ───
#
#  The first SUPER_ADMIN is created by the first request against a fresh
#  database. This is identity infrastructure, not seed data — `no-seed-data`
#  agrees, because there is no INSERT of a business row anywhere in the
#  migrations. The account is forced through a password change and TOTP
#  enrolment before it can do anything, after which these secrets are inert.

# [O]
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# [O] Used exactly once. Make it long; it does not need to be memorable.
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME


# ═════════════════════════════════════════════════════════════════════════════
#  SECTION B — platform_config  (147 keys)
# ═════════════════════════════════════════════════════════════════════════════
#
#  These are NOT environment variables. They are rows in the `platform_config`
#  table, edited from the admin panel, and they are listed here because this
#  file is the single register of everything the platform can be configured
#  with. `env-example-complete` checks that every key read by the Brain or by
#  undal-core appears below.
#
#  The table is TEMPORAL: a change inserts a new row with an `effective_at`,
#  and nothing is ever mutated. That means any past decision can be replayed
#  against the configuration that was actually in force when it was made —
#  which is what makes the Brain Lab's replay requirement meaningful.
#
#  Every key is zone-scopable; a row with a zone_id overrides the global
#  default. Every key has a JSON Schema and a range, validated at write time.
#  Propagation is ≤ 60 seconds.
#
#  Format below:  key = default            # range — description


# ─── B1. Fare ────────────────────────────────────────────────── 24 keys ────
#  The algebra these feed is docs/10. Money is always paisa, always INT8.

fare.base_fare_motorbike_paisa          = 4000      # 1000–15000 — ৳40.00 flagfall
fare.base_fare_bicycle_paisa            = 2500      # 1000–10000 — ৳25.00 flagfall
fare.per_km_motorbike_paisa             = 1400      # 500–4000   — ৳14/km, from the brief
fare.per_km_bicycle_paisa               = 800       # 300–2500   — ৳8/km, from the brief
fare.included_distance_m                = 2000      # 0–5000     — distance inside the base fare
fare.min_delivery_fee_motorbike_paisa   = 2500      # 0–10000    — customer-facing floor
fare.min_delivery_fee_bicycle_paisa     = 2000      # 0–10000
fare.max_delivery_fee_motorbike_paisa   = 22000     # 5000–60000 — customer-facing ceiling
fare.max_delivery_fee_bicycle_paisa     = 12000     # 5000–40000
fare.platform_delivery_margin_bps       = 800       # 0–3000     — 8% of ride_core, taxable revenue
fare.min_rider_payout_motorbike_paisa   = 3500      # 1000–10000 — paid even on a 300 m trip
fare.min_rider_payout_bicycle_paisa     = 2200      # 1000–8000
fare.traffic_bucket_s                   = 300       # 60–900     — the brief's "per 5 minutes"
fare.traffic_comp_motorbike_paisa       = 800       # 0–3000     — per completed bucket
fare.traffic_comp_bicycle_paisa         = 500       # 0–2000
fare.traffic_comp_max_buckets           = 6         # 1–20       — caps a GPS anomaly
fare.weather_rain_bps                   = 2000      # 0–6000     — +20%, platform-funded
fare.weather_storm_bps                  = 4000      # 0–10000    — +40%, platform-funded
fare.weather_heat_bps                   = 1500      # 0–6000     — +15% above 38°C
fare.weather_min_confidence             = 0.5       # 0.0–1.0    — below this, no premium is paid
fare.bicycle_min_distance_m             = 0         # 0–3000
fare.bicycle_max_distance_m             = 4000      # 2000–6000  — the brief's 3–4 km lock
fare.motorbike_max_distance_m           = 12000     # 4000–25000 — the brief's "4–10+ km"
fare.quote_validity_s                   = 300       # 60–900     — then 409 QUOTE_MISMATCH


# ─── B2. Surge ───────────────────────────────────────────────── 9 keys ─────
#  SDR = active_riders / active_orders. Multiplies the BASE FARE ONLY.
#  The ±0.05 ramps bridge the brief's bands so the curve is continuous and
#  cannot be gamed at a cliff edge. docs/10 §4.

surge.bands                             = [{"sdr_max":0.45,"formula":"1.5+(0.5-sdr)/0.5*0.7"},{"sdr_min":0.55,"sdr_max":0.95,"formula":"1.2+(1.0-sdr)/0.5*0.2"},{"sdr_min":1.05,"value":1.0}]
surge.max_bps                           = 22000     # 10000–30000 — hard server-side ceiling, 2.2×
surge.min_bps                           = 10000     # fixed 10000 — surge never reduces a fare
surge.ramp_width                        = 0.05      # 0.0–0.2     — linear bridge either side of a band
surge.sdr_window_s                      = 300       # 60–1800     — the averaging window
surge.sdr_min_orders                    = 3         # 1–20        — below this, SDR is not computed
surge.publish_interval_s                = 60        # 30–300      — how often riders see the heat map
surge.applies_to                        = "base_only"   # base_only | base_and_distance
surge.zone_override_enabled             = true      # bool        — may a zone pin its own multiplier


# ─── B3. Commission and fees ─────────────────────────────────── 7 keys ─────
#  No listing fee. No advertising. No CPC. Not configurable, because they do
#  not exist — see the anti-ad invariant in docs/13 §1.

commission.commission_bps               = 1500      # 0–3000  — 15%, from the brief
commission.rider_bonus_bps              = 300       # 0–1000  — 3%, VENDOR-FUNDED pass-through
commission.tax_bps                      = 500       # 0–2000  — 5% on the platform's fee revenue only
commission.small_order_threshold_paisa  = 10000     # 0–50000 — ৳100 post-discount subtotal
commission.small_order_fee_delivery_paisa = 2500    # 0–10000 — ৳25
commission.small_order_fee_pickup_paisa = 2000      # 0–10000 — ৳20
commission.small_order_split            = {"rider_paisa":500,"vendor_paisa":500,"platform_paisa":1500}


# ─── B4. Dispatch ────────────────────────────────────────────── 21 keys ────
#  The 14 weights MUST sum to 1.000; a write that breaks this is rejected.
#  Changing any of them in the Brain Lab requires a replay against the last
#  500 real decisions before it can be saved. docs/11, docs/21 §4.

dispatch.weight.proximity               = 0.170     # 0.0–1.0
dispatch.weight.eta_fit                 = 0.150     # 0.0–1.0 — asymmetric; late is worse than early
dispatch.weight.acceptance              = 0.130     # 0.0–1.0 — Wilson lower bound
dispatch.weight.reliability             = 0.110     # 0.0–1.0
dispatch.weight.fairness                = 0.095     # 0.0–1.0 — costs 38s of assignment, halves the Gini
dispatch.weight.completion              = 0.075     # 0.0–1.0
dispatch.weight.cash_headroom           = 0.060     # 0.0–1.0
dispatch.weight.area_familiarity        = 0.055     # 0.0–1.0
dispatch.weight.vehicle_fit             = 0.050     # 0.0–1.0
dispatch.weight.rating                  = 0.045     # 0.0–1.0
dispatch.weight.batch_affinity          = 0.040     # 0.0–1.0
dispatch.weight.idle_time               = 0.040     # 0.0–1.0
dispatch.weight.zone_adherence          = 0.020     # 0.0–1.0
dispatch.weight.device_health           = 0.020     # 0.0–1.0 — a phone that cannot alarm cannot be offered
dispatch.wave_target_acceptance         = 0.90      # 0.5–0.99 — wave sized until prod(1-p_i) < 0.10
dispatch.wave_max_size                  = 6         # 1–12
dispatch.wave_ttl_s                     = [25,25,22,20,20]
dispatch.search_radius_initial_m        = 2500      # 500–8000
dispatch.search_radius_max_m            = 7000      # 2000–15000
dispatch.expansion_ladder_s             = [112,140,175,215,300,480]   # then AUTO_CANCEL + ৳50 credit
dispatch.prewarm_enabled                = true      # bool — score at PLACED, before vendor accept


# ─── B5. Batching ────────────────────────────────────────────── 11 keys ────
#  Constraint C3 is absolute: a bundle NEVER pushes an order past the eta_max
#  already quoted to that customer. docs/12 §4.

batch.max_orders_motorbike              = 3         # 1–4
batch.max_orders_bicycle                = 2         # 1–2
batch.max_items_motorbike               = 24        # 4–40   — a bag has a physical size
batch.max_items_bicycle                 = 10        # 2–20
batch.max_spread_motorbike_m            = 6000      # 1000–12000 — drop-point spread
batch.max_spread_bicycle_m              = 3000      # 500–5000
batch.max_detour_s                      = 420       # 60–900 — extra wait for a bundled customer
batch.max_detour_temp_critical_s        = 210       # 60–600 — ice cream, cold drinks
batch.ready_window_s                    = 360       # 60–900 — prep times must fall inside this
batch.score_gate                        = 0.45      # 0.0–1.0 — below this, no bundle is offered
batch.customer_credit                   = {"bps":3000,"cap_paisa":2500}  # 30% of the fee, capped at ৳25


# ─── B6. Ranking and personalisation ─────────────────────────── 16 keys ────
#  NO MONETARY KEY APPEARS HERE AND NONE EVER WILL. `anti-ad-invariant` fails
#  the build if a money field becomes reachable from RankInput. docs/13 §1.

rank.weight.performance                 = 0.30      # 0.0–1.0
rank.weight.proximity                   = 0.26      # 0.0–1.0
rank.weight.personal                    = 0.22      # 0.0–1.0
rank.weight.query                       = 0.14      # 0.0–1.0
rank.weight.popularity                  = 0.08      # 0.0–1.0
rank.weight.context.time_of_day         = 0.22      # 0.0–1.0
rank.weight.context.weather             = 0.14      # 0.0–1.0
rank.weight.context.day_type            = 0.12      # 0.0–1.0
rank.weight.context.basket_affinity     = 0.26      # 0.0–1.0
rank.weight.context.repeat              = 0.18      # 0.0–1.0
rank.weight.context.novelty             = 0.08      # 0.0–1.0
rank.personal_cap                       = 0.22      # 0.0–0.30 — a hard ceiling on filter-bubble effect
rank.cold_start_max                     = 0.14      # 0.0–0.25 — the new-vendor boost, not purchasable
rank.cold_start_days                    = 21        # 7–60
rank.cold_start_rated_orders            = 25        # 5–100    — whichever comes first
rank.mmr_lambda                         = 0.78      # 0.5–1.0  — diversity; 1.0 means pure relevance


# ─── B7. Presence ────────────────────────────────────────────── 6 keys ─────
#  The brief's two-second offline detection, and the two-minute vendor
#  auto-cancel. No cron and no polling anywhere. docs/14.

presence.heartbeat_interval_ms          = 750       # 250–3000 — catches a silently dead transport
presence.deadline_ms                    = 2000      # 1000–10000 — the DO alarm horizon
presence.grace_ms                       = 1500      # 0–5000   — a reconnect inside this is not a state change
presence.transport_close_ms             = 200       # 50–1000  — detection on a clean socket close
presence.vendor_escalation_ladder_s     = [0,8,10,25,45,60,90,120]
presence.vendor_unreachable_cancel_s    = 120       # 60–600   — then AUTO_CANCELLED, reason
                                                    #            VENDOR_DEVICE_UNREACHABLE, with an
                                                    #            evidence block and ৳50 to the customer


# ─── B8. Live tracking ───────────────────────────────────────── 12 keys ────
#  D1 holds rider positions and nothing else. The channel opens on shift start
#  or order accept and is ERASED on every shift-ending path. docs/07.

tracking.displacement_idle_m            = 150       # 50–500   — the brief's "≥100 m", widened when idle
tracking.interval_idle_s                = 300       # 60–900
tracking.displacement_carrying_m        = 60        # 25–200
tracking.interval_carrying_s            = 25        # 10–120
tracking.displacement_near_drop_m       = 40        # 15–150
tracking.interval_near_drop_s           = 15        # 5–60
tracking.near_drop_radius_m             = 400       # 100–1000 — when the cadence tightens
tracking.max_accuracy_m                 = 60        # 20–200   — a worse fix is discarded, not stored
tracking.batch_max_points               = 12        # 1–30     — ~410 bytes per batched POST
tracking.ring_buffer_rows               = 120       # 30–500   — per rider, WITHOUT ROWID
tracking.spoof_max_speed_kmh            = 120       # 60–200   — exceeding it suspends and raises CRITICAL
tracking.stale_ladder_s                 = [20,45,90,180]   # live → lagging → stale → unknown


# ─── B9. Finance ─────────────────────────────────────────────── 14 keys ────
#  No cron. Invoices are generated by a period-boundary check on naturally
#  occurring requests, under an advisory lock. docs/24 §4.

finance.rider_payout_day                = "FRIDAY"      # from the brief
finance.vendor_payout_day               = "SATURDAY"    # from the brief
finance.period_start_day                = "MONDAY"
finance.period_timezone                 = "Asia/Dhaka"  # never the device timezone
finance.rider_cash_cap_paisa            = 350000        # 50000–1000000 — ৳3,500 exposure ceiling
finance.rider_cash_warn_bps             = 8000          # 0–10000 — warn the rider at 80% of the cap
finance.rider_weekly_liability_cap_paisa = 30000        # 0–100000 — ৳300, docs/24 §9
finance.settlement_review_sla_s         = 1800          # 300–7200  — the 30-minute human promise
finance.settlement_auto_lift_s          = 7200          # 1800–86400 — the block lifts itself at 2 h and
                                                        #              the breach is recorded as a
                                                        #              PLATFORM failure, not a rider one
finance.settlement_escalate_s           = 43200         # 7200–172800 — 12 h escalates to SUPER_ADMIN
finance.bkash_tariff_table              = [{"max_paisa":100000,"charge_paisa":500},{"max_paisa":500000,"charge_paisa":1850}]
finance.payout_account_cooling_off_h    = 72            # 0–336 — a changed payout account holds payouts
finance.invoice_pdf_max_bytes           = 1048576       # 262144–2097152 — the brief's 1 MB cap
finance.shortfall_recovery_max_bps      = 2500          # 0–5000 — never take more than 25% of one payout


# ─── B10. Alarm ──────────────────────────────────────────────── 8 keys ─────
#  The second-most-important requirement in the brief after ordering itself.
#  docs/15. Note what is NOT configurable: the alarm is always data-only,
#  always high priority, and audio always starts at t=0.

alarm.partner_ceiling_s                 = 120       # 30–300  — then it stops; a phone is not a siren
alarm.rider_ceiling_s                   = 25        # 10–60   — matches the offer TTL
alarm.repulse_interval_s                = 20        # 10–120  — re-send if unacknowledged
alarm.repulse_max                       = 3         # 0–6
alarm.fcm_ttl_s                         = 120       # 30–600  — a stale order must not ring later
alarm.health_recheck_days               = 7         # 1–30    — the device-health re-prompt
alarm.consecutive_failures_to_exclude   = 3         # 1–10    — then removed from dispatch, and told why
alarm.volume_floor_bps                  = 10000     # 5000–10000 — fraction of max alarm volume


# ─── B11. Feature flags ──────────────────────────────────────── 19 keys ────
#  Every flag has an owner and a removal date recorded alongside it. A flag
#  past its removal date raises a housekeeping exception, because permanent
#  feature flags are just untested code paths.

features.google_signin                  = false     # auto-true when both OAuth secrets exist
features.batching                       = true
features.surge                          = true
features.weather_premium                = true
features.pickup                         = true
features.flash_box                      = true
features.loyalty                        = false
features.referral                       = false
features.scheduled_orders               = false
features.bicycle_riders                 = true
features.home_kitchens                  = true
features.sandbox_order                  = true      # lets a vendor hear their first alarm on purpose
features.rider_night_mode               = true
features.super_map_webgl                = true      # false falls back to Leaflet, capped at 300 markers
features.admin_sso                      = false
features.impersonation                  = true      # read-only, time-boxed, banner + notification
features.bn_numerals_default            = false     # Bengali digits for a new bn user
features.prerender_long_tail            = true      # false pre-renders only the top pages
features.coordination_mode              = "cockroach"   # cockroach | durable-object
                                                        #
                                                        # "cockroach" is FREE and fully functional:
                                                        # 31 ms claim, 1.9 s presence detection.
                                                        # "durable-object" needs Workers Paid at
                                                        # $5/month and gives 4 ms and 1.7 s.
                                                        # Launch on cockroach. Switch when order
                                                        # volume passes roughly 3,000/day.
                                                        # docs/39 §2.2 — this is the ONLY thing in
                                                        # the whole platform that costs money.


