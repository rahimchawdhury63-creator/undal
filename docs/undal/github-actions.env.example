# DOCUMENTATION ONLY. Configure these in GitHub Settings / Secrets and variables.
# No real credentials belong in this file. Blank secret values block relevant jobs.
# .invalid origins are safe examples, not live endpoints or production defaults.
# S = protected environment/repository secret; V = Actions variable/public config.
# The implementation must validate account capabilities and document each consumer.

# V — environment, stable package names, initial locale/currency/timezone
UNDAL_ENVIRONMENT=production
UNDAL_CURRENCY=BDT
UNDAL_TIMEZONE=Asia/Dhaka
UNDAL_DEFAULT_LOCALE=bn
UNDAL_SUPPORTED_LOCALES=bn,en
ANDROID_MIN_SDK=26
CUSTOMER_APPLICATION_ID=bd.undal.customer
PARTNER_APPLICATION_ID=bd.undal.partner
RIDER_APPLICATION_ID=bd.undal.rider

# V — real origins selected in setup; never use localhost in production bundles
CUSTOMER_WEB_ORIGIN=https://customer.example.invalid
ADMIN_WEB_ORIGIN=https://admin.example.invalid
COMMERCE_API_ORIGIN=https://commerce.example.invalid
REALTIME_API_ORIGIN=https://realtime.example.invalid
ADMIN_API_ORIGIN=https://admin-api.example.invalid
ALLOWED_CUSTOMER_ORIGINS=https://customer.example.invalid
ALLOWED_ADMIN_ORIGINS=https://admin.example.invalid
CUSTOMER_APP_LINK_HOSTS=customer.example.invalid
PUBLIC_DOWNLOADS_ORIGIN=https://downloads.example.invalid
SEO_CANONICAL_ORIGIN=https://customer.example.invalid
SEO_PUBLICATION_MODE=prerender

# V — Cloudflare identity/names; select actual names during preflight
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CUSTOMER_PAGES_PROJECT=undal-customer
ADMIN_PAGES_PROJECT=undal-admin
COMMERCE_WORKER_NAME=undal-commerce
REALTIME_WORKER_NAME=undal-realtime
ADMIN_WORKER_NAME=undal-admin-ops
DO_STORAGE_BACKEND=sqlite
# S — deploy permission only for needed resources; not the account master key
CLOUDFLARE_API_TOKEN=

# V — Supabase public identity; publishable/anon key is not a service-role secret
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://project.example.invalid
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_ISSUER=https://project.example.invalid/auth/v1
# S — isolate CI management/migration from runtime privileged access
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
# S — bootstrap once; remove/rotate when no longer needed
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=

# V — Firebase client/project identity; actual public configs generated by setup
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=https://database.example.invalid
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_VAPID_PUBLIC_KEY=
FIREBASE_CUSTOMER_ANDROID_APP_ID=
FIREBASE_PARTNER_ANDROID_APP_ID=
FIREBASE_RIDER_ANDROID_APP_ID=
# S — restricted runtime service account; never included in Android/web assets
FIREBASE_SERVICE_ACCOUNT_JSON=
# S — optional, if CI identity federation is supported/configured
GOOGLE_WORKLOAD_IDENTITY_PROVIDER=
GOOGLE_CI_SERVICE_ACCOUNT=

# S — public-media upload only; rotate the credential exposed in the original brief
IMGBB_API_KEY=
# V — conservative upload policy, validated against supported codecs/CPU/provider
PUBLIC_IMAGE_MAX_BYTES=3145728
PUBLIC_IMAGE_MAX_PIXELS=16000000
PUBLIC_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
# V — private R2 file bytes; Supabase stores metadata/ACL/audit only
PRIVATE_MEDIA_BACKEND=cloudflare_r2
R2_PRIVATE_EVIDENCE_BUCKET=undal-private-evidence
R2_PRIVATE_INVOICES_BUCKET=undal-private-invoices
R2_STORAGE_CLASS=Standard
R2_PUBLIC_ACCESS_ENABLED=false
PRIVATE_MEDIA_DELIVERY_MODE=authenticated_worker
PRIVATE_UPLOAD_MAX_BYTES=4194304
PRIVATE_IMAGE_MAX_PIXELS=16000000
PRIVATE_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
# Wrangler native binding names are PRIVATE_EVIDENCE and PRIVATE_INVOICES.
# Disable r2.dev AND public bucket custom domains; do not expose direct object URLs.
# Runtime uses bindings in the existing three Workers: no S3 credentials in clients.
# S — optional invoice-bucket-scoped CI writer only if gateway upload is not used
R2_INVOICE_WRITER_ACCESS_KEY_ID=
R2_INVOICE_WRITER_SECRET_ACCESS_KEY=
# V — optional S3 endpoint derived from the actual Cloudflare account, CI-only use
R2_S3_ENDPOINT=
# V — owner confirms current R2 checkout/subscription requirements before enablement
R2_ACCOUNT_SETUP_CONFIRMED=false

# V — map/routing adapters and provider terms must be chosen and verified
MAP_TILE_PROVIDER=
MAP_TILE_URL_TEMPLATE=
MAP_ATTRIBUTION=
ROUTING_PROVIDER=
ROUTING_BASE_URL=
GEOCODING_PROVIDER=
GEOCODING_BASE_URL=
# S — only when the selected permitted free provider requires keys
MAP_PROVIDER_API_KEY=
ROUTING_API_KEY=
GEOCODING_API_KEY=

# S — operational remittance/payout settings, exposed only to authorized users
UNDAL_BKASH_REMITTANCE_NUMBER=
UNDAL_NAGAD_REMITTANCE_NUMBER=
# V — policy data/version is required; no guessed tax/fare defaults
FINANCIAL_POLICY_VERSION=
COMMISSION_BPS=1500
PROPOSED_VENDOR_DEDUCTION_BPS=500
VENDOR_DEDUCTION_CLASSIFICATION=unapproved
PROPOSED_RIDER_BONUS_BPS=300
RIDER_BONUS_BASE=unapproved
RIDER_BONUS_FUNDING=unapproved
MOTORBIKE_EXTRA_DISTANCE_POISHA_PER_KM=1400
BICYCLE_EXTRA_DISTANCE_POISHA_PER_KM=800
FARE_INCLUDED_DISTANCE_METERS=2000
MOTORBIKE_BASE_FARE_POISHA=
BICYCLE_BASE_FARE_POISHA=
MOTORBIKE_TRAFFIC_STEP_POISHA=
BICYCLE_TRAFFIC_STEP_POISHA=
EXTREME_HEAT_POLICY=
PAYOUT_FEE_POLICY_VERSION=
CASH_EXPOSURE_POLICY_VERSION=
# These rates require approved policy; setting a variable is not legal approval.

# V — quota inputs must be confirmed from current account limits, not guessed
RTDB_MAX_CONNECTIONS=
RTDB_CONNECTION_RESERVE=
RTDB_MONTHLY_DOWNLOAD_BUDGET_BYTES=
WORKERS_ACCOUNT_DAILY_REQUEST_BUDGET=
DO_DAILY_REQUEST_BUDGET=
DO_DAILY_DURATION_GB_SECONDS_BUDGET=
DO_DAILY_ROWS_WRITTEN_BUDGET=
SUPABASE_DATABASE_BUDGET_BYTES=
R2_STANDARD_STORAGE_BUDGET_BYTES=
R2_MONTHLY_CLASS_A_OPERATION_BUDGET=
R2_MONTHLY_CLASS_B_OPERATION_BUDGET=
R2_QUOTA_RESERVE_PERCENT=20
# Budgets include both buckets/other account consumers. Free allowances are finite.
# Guards are not a provider-enforced spending cap; overages can be billed.
ACTIONS_MONTHLY_MINUTE_BUDGET=
QUOTA_WARNING_PERCENT=60
QUOTA_SOFT_LIMIT_PERCENT=75
QUOTA_ADMISSION_STOP_PERCENT=85

# S — 11 OAuth adapter credentials are applied to Supabase server configuration
# Google intended initially; all others default disabled until verified.
OAUTH_PROVIDER_CONFIG_JSON=
# V — only actual ready providers may appear in enabled list
ENABLED_OAUTH_PROVIDERS=

# S — protected one-time bootstrap credential with Secrets API write permission
# Revoke/remove after signing secrets are installed; GITHUB_TOKEN is not assumed.
SIGNING_BOOTSTRAP_SECRETS_TOKEN=
SIGNING_BACKUP_PASSPHRASE=
# S — persistent independently generated signing identities, never debug fallback
CUSTOMER_KEYSTORE_BASE64=
CUSTOMER_KEYSTORE_PASSWORD=
CUSTOMER_KEY_ALIAS=
CUSTOMER_KEY_PASSWORD=
PARTNER_KEYSTORE_BASE64=
PARTNER_KEYSTORE_PASSWORD=
PARTNER_KEY_ALIAS=
PARTNER_KEY_PASSWORD=
RIDER_KEYSTORE_BASE64=
RIDER_KEYSTORE_PASSWORD=
RIDER_KEY_ALIAS=
RIDER_KEY_PASSWORD=
# V — upload/distribution fingerprints are public; use actual certificates
CUSTOMER_RELEASE_CERT_SHA256=
CUSTOMER_PLAY_APP_SIGNING_CERT_SHA256=
PARTNER_RELEASE_CERT_SHA256=
RIDER_RELEASE_CERT_SHA256=

# S — optional scoped GitHub App for coalesced content/PDF workflow triggering
# Use a supported free authentication design, never a broad embedded owner token.
OPERATIONS_GITHUB_APP_ID=
OPERATIONS_GITHUB_APP_INSTALLATION_ID=
OPERATIONS_GITHUB_APP_PRIVATE_KEY=

# S — optional only if a permitted free email provider is required/configured
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# The application must not read this example as live configuration.
# Never prefix service/private secrets with VITE_ or put them in Dart defines.
# Add verified current tool versions and any adapter-specific values in setup docs.
